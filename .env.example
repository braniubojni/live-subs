# Copy to .env, then load into your shell from the repo root:
#   set -a; . ./.env; set +a
# live-subs reads the process environment. It does not load .env itself.

WHISPER_BIN=$PWD/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=$PWD/models/ggml-tiny.bin
LLAMA_BIN=$PWD/llama.cpp/build/bin/llama-cli
LLAMA_MODEL=$PWD/models/cleanup-q4.gguf

# Optional. Exact input device name. Linux: a `.monitor` source from
# `pactl list sources short`. Unset = default output device.
# SUBS_DEVICE=

# Optional. Log filter. Default: live_subs=info
# RUST_LOG=live_subs=debug
