# Copy to .env in the directory you run live-subs from. It is loaded on
# startup; variables already set in your shell win over it.
# Paths are relative to that directory.

WHISPER_BIN=whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=models/ggml-tiny.bin
LLAMA_BIN=llama.cpp/build/bin/llama-cli
LLAMA_MODEL=models/cleanup-q4.gguf

# Optional. Exact input device name. Linux: a `.monitor` source from
# `pactl list sources short`. Unset = default output device.
# SUBS_DEVICE=

# Optional. Log filter. Default: live_subs=info
# RUST_LOG=live_subs=debug

# Optional: warm llama-server cleaner (path to the built binary)
# LLAMA_SERVER=llama.cpp/build/bin/llama-server
